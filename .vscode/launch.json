{
    // Pick one in the Run and Debug panel (Ctrl+Shift+D), then press F5 (debug) or Ctrl+F5 (run).
    // Every Python entry point starts ComfyUI by itself if it isn't running, so no terminal is needed.
    // Settings (video, start, seconds, shot, denoise ...) live in config/project.yaml, or project.example.yaml.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Phase 4: extract style frames (film in training/input)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/training/extract_style.py",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 4: caption style frames and actor photos",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/training/caption.py",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 4: set up the training environment (once)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/setup_training.py",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 4: train style LoRA (close ComfyUI first)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/training/train.py",
            "args": ["--target", "style"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 4: train actor LoRA Adwait (close ComfyUI first)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/training/train.py",
            "args": ["--target", "Adwait"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 4: training smoke test (20 steps, Adwait)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/training/train.py",
            "args": ["--target", "Adwait", "--smoke"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 4: comparison grid for the actor LoRA (Adwait)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/training/eval_grid.py",
            "args": ["--target", "Adwait"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 4: comparison grid for the style LoRA",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/training/eval_grid.py",
            "args": ["--target", "style"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 2: convert video (config input)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cli.py",
            "args": ["run"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 2: short preview (config input, 4 s default)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cli.py",
            "args": ["preview"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 3 cloud: pack the Kaggle bundle (config shot)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/make_cloud_bundle.py",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 3 cloud: deflicker the AnimateDiff result (config shot)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cli.py",
            "args": ["deflicker", "--source", "animatediff"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 3 cloud: flicker check of the AnimateDiff result",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cli.py",
            "args": ["flicker", "--stage", "animatediff"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 3 cloud: flicker check of the deflickered AnimateDiff result",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cli.py",
            "args": ["flicker", "--stage", "deflicker_animatediff"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 3 cloud: encode the AnimateDiff result to mp4",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cli.py",
            "args": ["encode", "--stage", "animatediff"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 3: deflicker (config shot)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cli.py",
            "args": ["deflicker"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 3: flicker check of the deflickered shot",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cli.py",
            "args": ["flicker", "--stage", "deflicker"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 2: flicker check (config shot)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cli.py",
            "args": ["flicker"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 1: single-frame smoke test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/test_single_frame.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Setup: download models",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/download_models.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Tests: pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests", "-q"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "ComfyUI server only (stays running, for the ComfyUI web page)",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}/scripts/start_comfyui.ps1",
            "args": []
        },
        {
            "name": "PowerShell: Launch Current File",
            "type": "PowerShell",
            "request": "launch",
            "script": "${file}",
            "args": []
        }
    ]
}
